{
  "name": "subux.dev",
  "private": true,
  "description": "A homepage that Introduce about subin",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vp build",
    "build.preview": "vp build --ssr src/entry.preview.tsx",
    "build.server": "vp build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler pages deploy ./dist",
    "dev": "vp dev --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite-plus/bin/vp dev --mode ssr --force",
    "fmt": "vp fmt",
    "fmt.check": "vp fmt --check",
    "lint": "vp lint",
    "lint.fix": "vp lint --fix",
    "check": "vp check",
    "preview": "qwik build preview && vp preview --open",
    "serve": "wrangler pages dev ./dist",
    "start": "vp dev --open --mode ssr",
    "qwik": "qwik",
    "test": "node --test src/lib/*.test.ts"
  },
  "dependencies": {
    "mermaid": "^12.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-wiki-link": "^2.0.1",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@qwik.dev/core": "2.0.0-rc.2",
    "@qwik.dev/router": "2.0.0-rc.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
