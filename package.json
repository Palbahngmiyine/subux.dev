{
  "name": "subux.dev",
  "private": true,
  "description": "A homepage that Introduce about subin",
  "scripts": {
    "build": "rm -rf dist && subux build -i src -o dist",
    "check": "subux check -i src",
    "deploy": "wrangler pages deploy ./dist",
    "dev": "pnpm build && wrangler pages dev ./dist",
    "serve": "wrangler pages dev ./dist"
  },
  "devDependencies": {
    "subux": "https://github.com/Palbahngmiyine/subux/releases/download/v0.3.0/subux-0.3.0.tgz",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
