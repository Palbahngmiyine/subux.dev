{
  "name": "subux.dev",
  "private": true,
  "description": "A homepage that Introduce about subin",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vp lint && node scripts/build.ts",
    "build.site": "node scripts/build.ts",
    "build.types": "tsc --noEmit",
    "deploy": "wrangler pages deploy ./dist",
    "dev": "node scripts/build.ts && wrangler pages dev ./dist",
    "fmt": "vp fmt",
    "fmt.check": "vp fmt --check",
    "lint": "vp lint",
    "lint.fix": "vp lint --fix",
    "check": "vp check",
    "serve": "wrangler pages dev ./dist",
    "test": "node --test scripts/*.test.ts"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.0",
    "hast-util-to-html": "^9.0.5",
    "lowlight": "^3.3.0",
    "mermaid": "^12.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
