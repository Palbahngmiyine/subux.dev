{
  "$description": "Design tokens of subux.dev, compiled by Subux into --sx-* CSS variables. Format: W3C Design Tokens Community Group. This site has one light theme, so every color is a plain $value shared by light and dark mode, and each shadow repeats its light value for dark. Differences from the Subux default tokens: no dark values, color.link, color.code.comment, font.sans and font.mono.",

  "color": {
    "$type": "color",

    "bg": { "$value": "#fafafa" },
    "bg-elevated": { "$value": "#ffffffb8" },
    "surface-muted": { "$value": "#0000000a" },
    "border": { "$value": "#00000014" },

    "text": { "$value": "#1f1f1f" },
    "text-muted": { "$value": "#666666" },
    "selection-bg": { "$value": "#171717" },
    "selection-text": { "$value": "#dddddd" },

    "primary": { "$value": "#c2e7ff" },
    "primary-hover": { "$value": "#a3d9ff" },
    "on-primary": { "$value": "#1f1f1f" },

    "accent": { "$value": "#ffdac2" },
    "accent-hover": { "$value": "#ffc9a3" },
    "on-accent": { "$value": "#1f1f1f" },

    "chip-neutral": { "$value": "#e4e4e4" },
    "on-chip-neutral": { "$value": "#1f1f1f" },

    "link": { "$value": "#3ba3d9", "$description": "Footnote reference link" },
    "focus-ring": {
      "$value": "#2b8cbf",
      "$description": "Footnote reference link hover"
    },
    "brand-mark": { "$value": "#33434c" },

    "status": {
      "success": {
        "fg": { "$value": "#116329" },
        "soft": { "$value": "#dafbe1" }
      },
      "warning": {
        "fg": { "$value": "#9a6700" },
        "soft": { "$value": "#fff8c5" }
      },
      "danger": {
        "fg": { "$value": "#cf222e" },
        "soft": { "$value": "#ffebe9" }
      },
      "info": {
        "fg": { "$value": "#0550ae" },
        "soft": { "$value": "#ddf4ff" }
      }
    },

    "row": {
      "normal": { "$value": "#1f1f1f" },
      "pending": { "$value": "#9a6700" },
      "failed": { "$value": "#cf222e" },
      "done": { "$value": "#666666" }
    },

    "code": {
      "text": { "$value": "#24292f" },
      "comment": { "$value": "#6a737d" },
      "keyword": { "$value": "#cf222e" },
      "number": { "$value": "#0550ae" },
      "string": { "$value": "#0a7f5a" },
      "title": { "$value": "#8250df" },
      "type": { "$value": "#953800" },
      "tag": { "$value": "#116329" },
      "builtin": { "$value": "#b35900" },
      "deletion-fg": { "$value": "#82071e" },
      "deletion-bg": { "$value": "#ffebe9" },
      "addition-fg": { "$value": "#116329" },
      "addition-bg": { "$value": "#dafbe1" },
      "diagram-bg": { "$value": "#f8fafc" }
    },

    "callout": {
      "note": { "$value": "#3b82f6" },
      "tip": { "$value": "#22c55e" },
      "important": { "$value": "#a855f7" },
      "warning": { "$value": "#eab308" },
      "caution": { "$value": "#ef4444" },
      "tldr": { "$value": "#06b6d4" },
      "info": { "$value": "#6366f1" },
      "todo": { "$value": "#f97316" },
      "hint": { "$value": "#14b8a6" },
      "success": { "$value": "#10b981" },
      "question": { "$value": "#8b5cf6" },
      "missing": { "$value": "#f43f5e" },
      "error": { "$value": "#dc2626" },
      "bug": { "$value": "#ec4899" },
      "example": { "$value": "#78716c" },
      "cite": { "$value": "#6b7280" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "light": {
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0",
          "color": "#0000000a"
        },
        "dark": {
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0",
          "color": "#0000000a"
        }
      }
    },
    "md": {
      "$value": {
        "light": {
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0",
          "color": "#00000014"
        },
        "dark": {
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0",
          "color": "#00000014"
        }
      }
    },
    "lg": {
      "$value": {
        "light": {
          "offsetX": "0",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0",
          "color": "#0000001f"
        },
        "dark": {
          "offsetX": "0",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0",
          "color": "#0000001f"
        }
      }
    }
  },

  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Pretendard Variable",
        "Pretendard",
        "-apple-system",
        "BlinkMacSystemFont",
        "system-ui",
        "Roboto",
        "Helvetica Neue",
        "Segoe UI",
        "Apple SD Gothic Neo",
        "Noto Sans KR",
        "Malgun Gothic",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": ["SF Mono", "Menlo", "Monaco", "Consolas", "monospace"]
    }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "20px" }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "8px" },
    "2": { "$value": "16px" },
    "3": { "$value": "24px" },
    "4": { "$value": "32px" },
    "5": { "$value": "40px" },
    "6": { "$value": "48px" },
    "7": { "$value": "56px" },
    "8": { "$value": "64px" },
    "9": { "$value": "72px" },
    "10": { "$value": "80px" }
  },

  "duration": {
    "$type": "duration",
    "fast": { "$value": "150ms" },
    "normal": { "$value": "250ms" },
    "slow": { "$value": "350ms" }
  },

  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.4, 0, 0.2, 1] }
  },

  "blur": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" }
  },

  "size": {
    "$type": "dimension",
    "touch-target-min": { "$value": "44px" }
  }
}
